      "targets": [
        {
          "expr": "sum by (variant) (rate(vector_component_received_events_total{variant=~\".*\"}[1m]))",
          "legendFormat": "{{variant}} events/s",
          "refId": "{"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "Vector Sent Bytes (to VictoriaLogs)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (variant) (rate(vector_component_sent_bytes_total{variant=~\".*\"}[1m]))",
          "legendFormat": "{{variant}} bytes/s",
          "refId": "{"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
