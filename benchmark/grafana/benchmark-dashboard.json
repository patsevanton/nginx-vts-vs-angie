{
  "title": "Nginx-VTS vs Angie Benchmark",
  "tags": [
    "benchmark",
    "nginx",
    "angie"
  ],
  "timezone": "browser",
  "panels": [
    {
      "title": "Сравнение: RPS by Variant",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_server_requests{variant=~\"$variant\",host=~\"$vhost\",host!=\"*\",code=\"total\"}[1m]))",
          "legendFormat": "nginx-vts-docker",
          "refId": "N"
        },
        {
          "expr": "sum(rate(angie_http_server_zones_requests_total{variant=~\"$variant\",zone=~\"$vhost\"}[1m]))",
          "legendFormat": "angie",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "Сравнение: Bytes Received (Ingress Traffic)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_server_bytes{host=~\"$vhost\",host!=\"*\",variant=~\"$variant\",direction=\"in\"}[1m]))",
          "legendFormat": "nginx-vts-docker bytes_in/s",
          "refId": "N"
        },
        {
          "expr": "sum(rate(angie_http_server_zones_data_received{variant=~\"$variant\",zone=~\"$vhost\"}[1m]))",
          "legendFormat": "angie bytes_in/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "Сравнение: Bytes Sent (Egress Traffic)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_server_bytes{host=~\"$vhost\",host!=\"*\",variant=~\"$variant\",direction=\"out\"}[1m]))",
          "legendFormat": "nginx-vts-docker bytes_out/s",
          "refId": "N"
        },
        {
          "expr": "sum(rate(angie_http_server_zones_data_sent{variant=~\"$variant\",zone=~\"$vhost\"}[1m]))",
          "legendFormat": "angie bytes_out/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "Сравнение: Vector Processed Events (events/s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (variant) (rate(vector_component_received_events_total{variant=~\"$variant\"}[1m]))",
          "legendFormat": "{{variant}} events/s",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "description": "События, обработанные vector (events/s), по variant.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "Сравнение: Vector Sent Bytes (to VictoriaLogs)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (variant) (rate(vector_component_sent_bytes_total{variant=~\"$variant\"}[1m]))",
          "legendFormat": "{{variant}} bytes/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "description": "Байты, отправленные vector в VictoriaLogs (bytes/s), по variant.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "Парные метрики nginx-vts (слева) vs angie (справа)",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "collapsed": false,
      "panels": [],
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "nginx-vts: Connection states (active/reading/writing/waiting)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "expr": "sum(nginx_server_connections{variant=~\"$variant\",status=\"active\"})",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "sum(nginx_server_connections{variant=~\"$variant\",status=\"reading\"})",
          "legendFormat": "reading",
          "refId": "R"
        },
        {
          "expr": "sum(nginx_server_connections{variant=~\"$variant\",status=\"writing\"})",
          "legendFormat": "writing",
          "refId": "W"
        },
        {
          "expr": "sum(nginx_server_connections{variant=~\"$variant\",status=\"waiting\"})",
          "legendFormat": "waiting",
          "refId": "D"
        }
      ],
      "description": "Gauge: мгновенные значения состояний соединений.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: Connection states (active/idle)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "targets": [
        {
          "expr": "sum(angie_connections_active{variant=~\"$variant\"})",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "sum(angie_connections_idle{variant=~\"$variant\"})",
          "legendFormat": "idle",
          "refId": "I"
        }
      ],
      "description": "Gauge: текущие активные и простаивающие соединения. Аналог reading/writing/waiting у nginx-vts отсутствует — Angie не разделяет неактивные соединения по состояниям.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "nginx-vts: Accepted/Handled connections, Requests (rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_server_connections{variant=~\"$variant\",status=\"accepted\"}[1m]))",
          "legendFormat": "accepted/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(nginx_server_connections{variant=~\"$variant\",status=\"handled\"}[1m]))",
          "legendFormat": "handled/s",
          "refId": "H"
        },
        {
          "expr": "sum(rate(nginx_server_connections{variant=~\"$variant\",status=\"requests\"}[1m]))",
          "legendFormat": "requests/s",
          "refId": "R"
        }
      ],
      "description": "Counter: принятые/обработанные соединения и суммарные запросы (rate).",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: Accepted/Dropped connections (rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum(rate(angie_connections_accepted{variant=~\"$variant\"}[1m]))",
          "legendFormat": "accepted/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(angie_connections_dropped{variant=~\"$variant\"}[1m]))",
          "legendFormat": "dropped/s",
          "refId": "D"
        }
      ],
      "description": "Counter: принятые и сброшенные соединения. Аналога handled/requests (в одном ряду с accepted) у angie нет — handled не экспортируется, requests учитываются в server_zones.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "nginx-vts: Server zone requests total (rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_server_requests{variant=~\"$variant\",host=~\"$vhost\",host!=\"*\",code=\"total\"}[1m]))",
          "legendFormat": "requests/s",
          "refId": "T"
        }
      ],
      "description": "Суммарные запросы server zone (rate) — аналог angie_http_server_zones_requests_total.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: Server zone requests (total rate, processing, discarded rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "targets": [
        {
          "expr": "sum(rate(angie_http_server_zones_requests_total{variant=~\"$variant\",zone=~\"$vhost\"}[1m]))",
          "legendFormat": "total/s",
          "refId": "T"
        },
        {
          "expr": "sum(angie_http_server_zones_requests_processing{variant=~\"$variant\",zone=~\"$vhost\"})",
          "legendFormat": "processing",
          "refId": "P"
        },
        {
          "expr": "sum(rate(angie_http_server_zones_requests_discarded{variant=~\"$variant\",zone=~\"$vhost\"}[1m]))",
          "legendFormat": "discarded/s",
          "refId": "D"
        }
      ],
      "description": "Серверная зона server_zone: всего запросов (rate), в обработке (gauge), отброшено (rate). processing/discarded у nginx-vts аналогов не имеют.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "nginx-vts: HTTP responses by code class (rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "targets": [
        {
          "expr": "sum by (code) (rate(nginx_server_requests{variant=~\"$variant\",host=~\"$vhost\",host!=\"*\",code!=\"total\"}[1m]))",
          "legendFormat": "{{code}}/s",
          "refId": "{"
        }
      ],
      "description": "1xx/2xx/3xx/4xx/5xx по классам кодов. Агрегат host=* исключён.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: HTTP responses by code (rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 49
      },
      "targets": [
        {
          "expr": "sum by (code) (rate(angie_http_server_zones_responses{variant=~\"$variant\",zone=~\"$vhost\"}[1m]))",
          "legendFormat": "{{code}}/s",
          "refId": "{"
        }
      ],
      "description": "Ответы по кодам (1xx/2xx/3xx/4xx/5xx) в server zone.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "nginx-vts: Server Request Processing Time (ms)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 57
      },
      "targets": [
        {
          "expr": "avg(nginx_server_requestMsec{variant=~\"$variant\",host=~\"$vhost\",host!=\"*\"})",
          "legendFormat": "nginx-vts-docker",
          "refId": "N"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "description": "Среднее время обработки запроса на стороне сервера (requestMsec). Аналога у angie нет — angie не экспортирует per-request processing time в server zone.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: (нет аналога server requestMsec)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 57
      },
      "targets": [],
      "description": "Заглушка: Angie не экспортирует среднее время обработки запроса в server zone (аналог nginx_server_requestMsec). Метрика отсутствует «из коробки». Панель оставлена для визуального параллелизма.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
