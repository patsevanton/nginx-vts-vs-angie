{
  "title": "Nginx-VTS vs Angie Benchmark",
  "tags": [
    "benchmark",
    "nginx",
    "angie"
  ],
  "timezone": "browser",
  "panels": [
    {
      "title": "RPS by Variant",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_server_requests{variant=\"nginx-vts-docker\",host=~\".*\"}[1m]))",
          "legendFormat": "nginx-vts-docker",
          "refId": "N"
        },
        {
          "expr": "sum(rate(angie_http_server_zones_requests_total{variant=\"angie\"}[1m]))",
          "legendFormat": "angie",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "Active Connections",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(nginx_server_connections{variant=\"nginx-vts-docker\",status=\"active\"})",
          "legendFormat": "nginx-vts-docker",
          "refId": "N"
        },
        {
          "expr": "sum(angie_connections_active{variant=\"angie\"})",
          "legendFormat": "angie",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "Bytes Received (Ingress Traffic)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_server_bytes{variant=\"nginx-vts-docker\",direction=\"in\"}[1m]))",
          "legendFormat": "nginx-vts-docker bytes_in/s",
          "refId": "N"
        },
        {
          "expr": "sum(rate(angie_http_server_zones_data_received{variant=\"angie\"}[1m]))",
          "legendFormat": "angie bytes_in/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "Bytes Sent (Egress Traffic)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_server_bytes{variant=\"nginx-vts-docker\",direction=\"out\"}[1m]))",
          "legendFormat": "nginx-vts-docker bytes_out/s",
          "refId": "N"
        },
        {
          "expr": "sum(rate(angie_http_server_zones_data_sent{variant=\"angie\"}[1m]))",
          "legendFormat": "angie bytes_out/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "HTTP 2xx Responses (rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_server_requests{variant=\"nginx-vts-docker\",code=\"2xx\"}[1m]))",
          "legendFormat": "nginx-vts-docker 2xx",
          "refId": "N"
        },
        {
          "expr": "sum(rate(angie_http_server_zones_responses{variant=\"angie\",code=~\"2..\"}[1m]))",
          "legendFormat": "angie 2xx",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "Upstream Response Time (avg, ms)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_upstream_responseMsec{variant=\"nginx-vts-docker\"}[1m])) / sum(rate(nginx_upstream_requests{variant=\"nginx-vts-docker\"}[1m]))",
          "legendFormat": "nginx-vts-docker",
          "refId": "N"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "Vector Processed Events",
