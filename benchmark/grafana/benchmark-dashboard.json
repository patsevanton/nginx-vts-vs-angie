{
  "title": "Nginx-VTS vs Angie Benchmark",
  "tags": [
    "benchmark",
    "nginx",
    "angie"
  ],
  "timezone": "browser",
  "panels": [
    {
      "title": "RPS by Variant",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_server_requests{variant=~\"$variant\",host=~\"$vhost\",host!=\"*\",code=\"total\"}[1m]))",
          "legendFormat": "nginx-vts-docker",
          "refId": "N"
        },
        {
          "expr": "sum(rate(angie_http_server_zones_requests_total{variant=~\"$variant\",zone=~\"$vhost\"}[1m]))",
          "legendFormat": "angie",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "Bytes Received (Ingress Traffic)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_server_bytes{host=~\"$vhost\",host!=\"*\",variant=~\"$variant\",direction=\"in\"}[1m]))",
          "legendFormat": "nginx-vts-docker bytes_in/s",
          "refId": "N"
        },
        {
          "expr": "sum(rate(angie_http_server_zones_data_received{variant=~\"$variant\",zone=~\"$vhost\"}[1m]))",
          "legendFormat": "angie bytes_in/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "Bytes Sent (Egress Traffic)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_server_bytes{host=~\"$vhost\",host!=\"*\",variant=~\"$variant\",direction=\"out\"}[1m]))",
          "legendFormat": "nginx-vts-docker bytes_out/s",
          "refId": "N"
        },
        {
          "expr": "sum(rate(angie_http_server_zones_data_sent{variant=~\"$variant\",zone=~\"$vhost\"}[1m]))",
          "legendFormat": "angie bytes_out/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "Upstream Request/Response Time (avg, ms)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_upstream_responseMsec{variant=~\"$variant\"}[1m])) / sum(rate(nginx_upstream_requests{variant=~\"$variant\"}[1m]))",
          "legendFormat": "nginx-vts-docker",
          "refId": "N"
        },
        {
          "expr": "avg(nginx_upstream_requestMsec{variant=~\"$variant\"})",
          "legendFormat": "nginx-vts requestMsec",
          "refId": "R"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "nginx_upstream_requestMsec (время запроса к upstream) и nginx_upstream_responseMsec (время ответа от upstream) — avg. Распределение по backend'ам не показывается отдельно, т.к. backend один."
    },
    {
      "title": "Vector Processed Events",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (variant) (rate(vector_component_received_events_total{variant=~\"$variant\"}[1m]))",
          "legendFormat": "{{variant}} events/s",
          "refId": "{"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "Vector Sent Bytes (to VictoriaLogs)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (variant) (rate(vector_component_sent_bytes_total{variant=~\"$variant\"}[1m]))",
          "legendFormat": "{{variant}} bytes/s",
          "refId": "{"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "nginx-vts-docker — детали метрик",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "collapsed": false,
      "panels": [],
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "nginx-vts: Connection states (active/reading/writing/waiting)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "expr": "sum(nginx_server_connections{variant=~\"$variant\",status=\"active\"})",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "sum(nginx_server_connections{variant=~\"$variant\",status=\"reading\"})",
          "legendFormat": "reading",
          "refId": "R"
        },
        {
          "expr": "sum(nginx_server_connections{variant=~\"$variant\",status=\"writing\"})",
          "legendFormat": "writing",
          "refId": "W"
        },
        {
          "expr": "sum(nginx_server_connections{variant=~\"$variant\",status=\"waiting\"})",
          "legendFormat": "waiting",
          "refId": "D"
        }
      ],
      "description": "Мгновенные значения состояний соединений (gauge).",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "nginx-vts: Accepted/Handled connections, Requests (rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_server_connections{variant=~\"$variant\",status=\"accepted\"}[1m]))",
          "legendFormat": "accepted/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(nginx_server_connections{variant=~\"$variant\",status=\"handled\"}[1m]))",
          "legendFormat": "handled/s",
          "refId": "H"
        },
        {
          "expr": "sum(rate(nginx_server_connections{variant=~\"$variant\",status=\"requests\"}[1m]))",
          "legendFormat": "requests/s",
          "refId": "R"
        }
      ],
      "description": "Счётчики (counter) в виде rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "nginx-vts: Cache status (rate by status)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(nginx_server_cache{variant=~\"$variant\",host=~\"$vhost\",host!=\"*\"}[1m]))",
          "legendFormat": "{{status}}/s",
          "refId": "{"
        }
      ],
      "description": "hit/miss/bypass/expired/revalidated/scarce/stale/updating. Агрегат host=* исключён (дублирует сумму по реальным vhost).",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "nginx-vts: Server Request Processing Time (ms)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "targets": [
        {
          "expr": "avg(nginx_server_requestMsec{variant=~\"$variant\",host=~\"$vhost\",host!=\"*\"})",
          "legendFormat": "nginx-vts-docker",
          "refId": "N"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "description": "Среднее время обработки запроса на стороне сервера.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "nginx-vts: HTTP responses by code class (rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "expr": "sum by (code) (rate(nginx_server_requests{variant=~\"$variant\",host=~\"$vhost\",host!=\"*\",code!=\"total\"}[1m]))",
          "legendFormat": "{{code}}/s",
          "refId": "{"
        }
      ],
      "description": "1xx/2xx/3xx/4xx/5xx/total. Агрегат host=* исключён (дублирует сумму по реальным vhost).",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "nginx-vts: Upstream Bytes (rate by direction)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "targets": [
        {
          "expr": "sum by (direction) (rate(nginx_upstream_bytes{variant=~\"$variant\"}[1m]))",
          "legendFormat": "{{direction}}/s",
          "refId": "{"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "nginx-vts: Upstream responses by code (rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "targets": [
        {
          "expr": "sum by (code) (rate(nginx_upstream_requests{variant=~\"$variant\"}[1m]))",
          "legendFormat": "{{code}}/s",
          "refId": "{"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "nginx-vts: Shared zones (usedsize/maxsize)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 49
      },
      "targets": [
        {
          "expr": "sum by (memstat) (nginx_server_sharedzones{variant=~\"$variant\"})",
          "legendFormat": "{{memstat}}",
          "refId": "{"
        }
      ],
      "description": "Использование shared-memory зоны ngx_http_vhost_traffic_status: usedsize и maxsize.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie — детали метрик",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 57
      },
      "collapsed": false,
      "panels": [],
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: Active/Idle connections",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 58
      },
      "targets": [
        {
          "expr": "sum(angie_connections_active{variant=~\"$variant\"})",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "sum(angie_connections_idle{variant=~\"$variant\"})",
          "legendFormat": "idle",
          "refId": "I"
        }
      ],
      "description": "Gauge: текущие активные и простаивающие соединения.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: Accepted/Dropped connections (rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 58
      },
      "targets": [
        {
          "expr": "sum(rate(angie_connections_accepted{variant=~\"$variant\"}[1m]))",
          "legendFormat": "accepted/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(angie_connections_dropped{variant=~\"$variant\"}[1m]))",
          "legendFormat": "dropped/s",
          "refId": "D"
        }
      ],
      "description": "Counter: принятые и сброшенные соединения.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: Server zone requests (total rate, processing, discarded rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 66
      },
      "targets": [
        {
          "expr": "sum(rate(angie_http_server_zones_requests_total{variant=~\"$variant\",zone=~\"$vhost\"}[1m]))",
          "legendFormat": "total/s",
          "refId": "T"
        },
        {
          "expr": "sum(angie_http_server_zones_requests_processing{variant=~\"$variant\",zone=~\"$vhost\"})",
          "legendFormat": "processing",
          "refId": "P"
        },
        {
          "expr": "sum(rate(angie_http_server_zones_requests_discarded{variant=~\"$variant\",zone=~\"$vhost\"}[1m]))",
          "legendFormat": "discarded/s",
          "refId": "D"
        }
      ],
      "description": "Серверная зона server_zone: всего запросов (rate), в обработке (gauge), отброшено (rate).",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: HTTP responses by code (rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 66
      },
      "targets": [
        {
          "expr": "sum by (code) (rate(angie_http_server_zones_responses{variant=~\"$variant\",zone=~\"$vhost\"}[1m]))",
          "legendFormat": "{{code}}/s",
          "refId": "{"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: Upstream keepalive connections",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 74
      },
      "targets": [
        {
          "expr": "sum by (upstream) (angie_http_upstreams_keepalive{variant=~\"$variant\"})",
          "legendFormat": "{{upstream}}",
          "refId": "{"
        }
      ],
      "description": "Текущее число keepalive-соединений к upstream.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: Upstream peer state",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 74
      },
      "targets": [
        {
          "expr": "sum by (peer) (angie_http_upstreams_peers_state{variant=~\"$variant\"})",
          "legendFormat": "{{peer}}",
          "refId": "{"
        }
      ],
      "description": "Состояние peer'а upstream (gauge: 0=up, др. значения = недоступен).",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: Upstream peers bytes (rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 82
      },
      "targets": [
        {
          "expr": "sum(rate(angie_http_upstreams_peers_data_received{variant=~\"$variant\"}[1m]))",
          "legendFormat": "received/s",
          "refId": "R"
        },
        {
          "expr": "sum(rate(angie_http_upstreams_peers_data_sent{variant=~\"$variant\"}[1m]))",
          "legendFormat": "sent/s",
          "refId": "S"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: Upstream peers responses by code (rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 82
      },
      "targets": [
        {
          "expr": "sum by (code) (rate(angie_http_upstreams_peers_responses{variant=~\"$variant\"}[1m]))",
          "legendFormat": "{{code}}/s",
          "refId": "{"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: Upstream peers health (fails/unavailable rate, downtime)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 90
      },
      "targets": [
        {
          "expr": "sum(rate(angie_http_upstreams_peers_health_fails{variant=~\"$variant\"}[1m]))",
          "legendFormat": "fails/s",
          "refId": "F"
        },
        {
          "expr": "sum(rate(angie_http_upstreams_peers_health_unavailable{variant=~\"$variant\"}[1m]))",
          "legendFormat": "unavailable/s",
          "refId": "U"
        },
        {
          "expr": "sum(angie_http_upstreams_peers_health_downtime{variant=~\"$variant\"})",
          "legendFormat": "downtime (s)",
          "refId": "D"
        }
      ],
      "description": "fails/unavailable — counter (rate); downtime — gauge в секундах.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: Upstream peers selected (current, total rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 90
      },
      "targets": [
        {
          "expr": "sum(angie_http_upstreams_peers_selected_current{variant=~\"$variant\"})",
          "legendFormat": "current",
          "refId": "C"
        },
        {
          "expr": "sum(rate(angie_http_upstreams_peers_selected_total{variant=~\"$variant\"}[1m]))",
          "legendFormat": "total/s",
          "refId": "T"
        }
      ],
      "description": "current — gauge (текущие выбранные); total — counter (rate).",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: Slabs pages (free/used)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 98
      },
      "targets": [
        {
          "expr": "sum(angie_slabs_pages_free{variant=~\"$variant\"})",
          "legendFormat": "free",
          "refId": "F"
        },
        {
          "expr": "sum(angie_slabs_pages_used{variant=~\"$variant\"})",
          "legendFormat": "used",
          "refId": "U"
        }
      ],
      "description": "Shared-memory slab zones (upstream_backend): свободные/занятые страницы.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: Slabs pages slots (used/free by size)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 98
      },
      "targets": [
        {
          "expr": "sum by (size) (angie_slabs_pages_slots_used{variant=~\"$variant\"})",
          "legendFormat": "used {{size}}",
          "refId": "U"
        },
        {
          "expr": "sum by (size) (angie_slabs_pages_slots_free{variant=~\"$variant\"})",
          "legendFormat": "free {{size}}",
          "refId": "F"
        }
      ],
      "description": "Слоты страниц по размеру: занятые и свободные.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    },
    {
      "title": "angie: Slabs pages slots activity (reqs/fails rate by size)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 106
      },
      "targets": [
        {
          "expr": "sum by (size) (rate(angie_slabs_pages_slots_reqs{variant=~\"$variant\"}[1m]))",
          "legendFormat": "reqs {{size}}/s",
          "refId": "R"
        },
        {
          "expr": "sum by (size) (rate(angie_slabs_pages_slots_fails{variant=~\"$variant\"}[1m]))",
          "legendFormat": "fails {{size}}/s",
          "refId": "F"
        }
      ],
      "description": "Запросы и неудачи выделения слотов по размерам.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
    }
  ],
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "variant",
        "type": "query",
        "label": "Variant",
        "description": "Прокси-вариант: nginx-vts-docker или angie (лейбл variant из метрик)",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "query": "label_values(variant)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "vhost",
        "type": "query",
        "label": "VHost (host/zone)",
        "description": "Виртуальный хост: лейбл host для nginx-vts, zone для angie (server_name/Host запроса)",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
