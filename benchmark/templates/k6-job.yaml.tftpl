apiVersion: batch/v1
kind: Job
metadata:
  name: k6-${variant}-${section}
  namespace: ${namespace}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 1800
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels:
        app: k6
        variant: "${variant}"
        section: "${section}"
    spec:
      restartPolicy: Never
      containers:
        - name: k6
          image: grafana/k6:2.1.0
          args:
            - "run"
            - "--env"
            - "VARIANT=${variant}"
            - "--env"
            - "SECTION=${section}"
            - "--env"
            - "MAX_VUS=${max_vus}"
            - "--env"
            - "TARGET=${target}"
            - "/scripts/benchmark.js"
          volumeMounts:
            - name: k6-script
              mountPath: /scripts
          resources:
            requests:
              cpu: 500m
              memory: 256Mi
            limits:
              cpu: "2"
              memory: 2Gi
      volumes:
        - name: k6-script
          configMap:
            name: k6-script
