vlselect:
  vmServiceScrape:
    enabled: true
  ingress:
    enabled: true
    hosts:
      - name: victorialogs.${lb_ip}.sslip.io
        path:
          - /
        port: http
    ingressClassName: nginx

vlinsert:
  vmServiceScrape:
    enabled: true
  ingress:
    enabled: true
    hosts:
      - name: vlinsert.${lb_ip}.sslip.io
        path:
          - /
        port: http
    ingressClassName: nginx

vlstorage:
  vmServiceScrape:
    enabled: true
  retentionPeriod: 1d
  persistentVolume:
    size: 20Gi
