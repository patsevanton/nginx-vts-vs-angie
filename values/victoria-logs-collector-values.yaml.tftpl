remoteWrite:
  - url: http://vlcluster-victoria-logs-cluster-vlinsert.vlcluster.svc.cluster.local.:9481
    ignoreFields:
      - kubernetes.container_id
      - kubernetes.pod_ip
      - kubernetes.pod_labels.pod-template-hash

collector:
  msgField:
    - message
    - msg

podMonitor:
  enabled: true
  vm: true
