fullnameOverride: vm-stack

grafana:
  plugins:
    - victoriametrics-logs-datasource
  env:
    GF_LOG_MODE: console
    GF_LOG_CONSOLE_FORMAT: json
  ingress:
    ingressClassName: nginx
    enabled: true
    hosts:
      - grafana.${lb_ip}.sslip.io
    annotations:
      nginx.ingress.kubernetes.io/ssl-redirect: "false"

defaultDatasources:
  extra:
    - name: victoriametrics-logs
      access: proxy
      type: victoriametrics-logs-datasource
      url: http://victoria-logs-cluster-vlselect.victoria-logs-cluster.svc.cluster.local:9471
      jsonData:
        maxLines: 1000
      version: 1

vmsingle:
  enabled: true
  ingress:
    enabled: true
    ingressClassName: nginx
    annotations:
      nginx.ingress.kubernetes.io/ssl-redirect: "false"
    hosts:
      - vmselect.${lb_ip}.sslip.io

kubeControllerManager:
  enabled: false

vmagent:
  enabled: true
  spec:
    externalLabels:
      cluster: nginx-vts-vs-angie
    # Secret с дополнительными scrape-конфигурациями (создаётся ниже в extraObjects)
    additionalScrapeConfigs:
      name: vmks-additional-scrape-configs
      key: scrape-configs.yaml

extraObjects:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: vmks-additional-scrape-configs
    stringData:
      scrape-configs.yaml: |
%{ for key, ip in vm_ips ~}
        - job_name: "nginx-vts-exporter-${key}"
          scrape_interval: 15s
          static_configs:
            - targets: ["${ip}:9913"]
              labels:
                variant: "nginx-vts"
                section: "${split("-", key)[1]}"
                instance: "${key}"
          metrics_path: /metrics
        - job_name: "vector-metrics-${key}"
          scrape_interval: 15s
          static_configs:
            - targets: ["${ip}:9598"]
              labels:
                variant: "nginx-vts"
                section: "${split("-", key)[1]}"
                component: "vector"
                instance: "${key}"
          metrics_path: /metrics
%{ endfor }
%{ for key, ip in angie_ips ~}
        - job_name: "angie-prometheus-${key}"
          scrape_interval: 15s
          static_configs:
            - targets: ["${ip}:80"]
              labels:
                variant: "angie"
                section: "${split("-", key)[1]}"
                instance: "${key}"
          metrics_path: /metrics
        - job_name: "vector-metrics-${key}"
          scrape_interval: 15s
          static_configs:
            - targets: ["${ip}:9598"]
              labels:
                variant: "angie"
                section: "${split("-", key)[1]}"
                component: "vector"
                instance: "${key}"
          metrics_path: /metrics
%{ endfor }
